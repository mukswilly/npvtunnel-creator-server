# Place this server block in nginx's HTTPS configuration after installing a
# certificate for the public hostname.
server {
    listen 443 ssl http2;
    server_name issuer.example.com;

    ssl_certificate /etc/ssl/issuer.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/issuer.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_request_buffering on;
        proxy_buffering off;
    }
}
